{
  "name": "deployagram-nodejs-emailer-mocha-proxy-demo",
  "version": "0.0.1",
  "private": true,
  "description": "A minimal Node.js/TypeScript HTTP service (the Emailer) with service tests, ported from deployagram-java-emailer-demo. Service tests use Mocha.",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --env-file-if-exists=.env ./node_modules/mocha/bin/mocha.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
